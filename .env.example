# ================================================
#  HISOBCHI BOT — SOZLAMALAR
#  Bu faylning nusxasini ".env" nomi bilan saqlang
#  va qiymatlarni o'zingiznikiga almashtiring.
# ================================================

# Neon.tech dan olingan PostgreSQL manzili (connection string, "-pooler" bilan)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.aws.neon.tech/neondb?sslmode=require"

# Xuddi shu manzil, lekin host nomidan "-pooler" olib tashlangan (jadvallarni yaratish uchun)
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.aws.neon.tech/neondb?sslmode=require"

# BotFather bergan bot tokeni
BOT_TOKEN="1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"

# Mini App'ning https manzili — "npm run dev" ngrok orqali o'zi yozadi
WEBAPP_URL=""

# ngrok authtoken: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=""
# (ixtiyoriy) ngrok'dagi doimiy domeningiz, masalan: abc-123.ngrok-free.app
NGROK_DOMAIN=""

# Backend porti
PORT=5000

# Admin panelga kirish paroli (o'zingiz o'ylab toping)
ADMIN_PASSWORD="admin12345"

# Kunlik hisobot bot orqali yuboriladigan vaqt (Toshkent vaqti, cron formatida)
DAILY_REPORT_CRON="0 21 * * *"

# true bo'lsa, Mini App'ni oddiy brauzerda (Telegram'siz) test qilish mumkin
ALLOW_DEV_AUTH=true
