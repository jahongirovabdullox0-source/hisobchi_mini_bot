{
  "name": "hisobchi-bot",
  "version": "1.0.0",
  "description": "Hisobchi — bog'dorchilik, chorvachilik, tadbirkorlik va chet el pullari uchun moliyaviy hisob-kitob boti (Telegram Mini App + Admin Panel)",
  "main": "src/index.js",
  "private": true,
  "scripts": {
    "start": "node src/index.js",
    "dev": "node scripts/dev.js",
    "dev:all": "concurrently -k -n API,APP,ADMIN -c blue,green,magenta \"npm run dev:api\" \"npm run dev:app\" \"npm run dev:admin\"",
    "dev:api": "nodemon --watch src src/index.js",
    "dev:app": "npm --prefix mini-app run dev",
    "dev:admin": "npm --prefix admin-panel run dev",
    "install:all": "npm install && npm --prefix mini-app install && npm --prefix admin-panel install",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev --name init",
    "db:seed": "node prisma/seed.js",
    "db:deploy": "prisma db push --skip-generate && node prisma/seed.js",
    "db:studio": "prisma studio",
    "setup": "npm run install:all && npm run db:push && npm run db:seed",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "node-cron": "^3.0.3",
    "prisma": "^5.22.0",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "nodemon": "^3.1.7"
  },
  "allowScripts": {
    "@prisma/client": true,
    "prisma": true,
    "@prisma/engines": true
  }
}
