# =====================================================
#  HISOBCHI — Git'ga yuklanmaydigan fayllar
# =====================================================

# --- Maxfiy sozlamalar: baza paroli, bot tokeni, ngrok token ---
.env
.env.*
!.env.example
ngrok.yml
*.pem

# --- Paketlar (npm install bilan qayta tiklanadi) ---
node_modules/

# --- Build natijalari (npm run dev / npm run build qayta yaratadi) ---
dist/
dist-ssr/
*.local

# --- Loglar ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Kesh va vaqtinchalik fayllar ---
.cache/
.vite/
.eslintcache
coverage/
tmp/
temp/
*.tmp

# --- Yuklab olingan Excel hisobotlar ---
Hisobot_*.xlsx
Hisobchi_*.xlsx

# --- Muharrir (editor) sozlamalari ---
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.sw?

# --- Operatsion tizim fayllari ---
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# --- Claude Code shaxsiy sozlamalari ---
.claude/settings.local.json

# --- Vercel CLI loyiha bog'lanishi ---
.vercel/
